{
  "type": "RSDOSE4",
  "access": {
    "no_GET": [],
    "PUT": [
      "/head/1/settings",
      "/head/2/settings",
      "/head/3/settings",
      "/head/4/settings"
    ]
  },
  "post_actions": [
    {
      "request": "/head/4/manual",
      "action": {
        "target": "/dashboard",
